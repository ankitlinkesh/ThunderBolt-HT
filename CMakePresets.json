{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "base",
      "description": "MSVC toolset pinned. S87 records the compiler in every result, and two toolsets are installed on the reference machine - leaving the choice implicit would make results ambiguous.",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "version=14.51", "strategy": "set" }
    },

    {
      "name": "dev",
      "inherits": "msvc",
      "displayName": "Dev (multi-config: Debug/Release/RelWithDebInfo)",
      "description": "Everyday build. Debug enables THUNDERBOLT_DEBUG assertions (S62)."
    },

    {
      "name": "asan",
      "inherits": "msvc",
      "displayName": "AddressSanitizer",
      "description": "ASan finds memory errors, NOT data races - it does not substitute for ThreadSanitizer, which is unavailable on MSVC. Based on RelWithDebInfo because /fsanitize=address is incompatible with the /RTC1 that Debug enables by default.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO"
      }
    },

    {
      "name": "ninja",
      "inherits": "base",
      "displayName": "Ninja RelWithDebInfo (requires a Developer Command Prompt)",
      "description": "Faster iteration and the preferred configuration for benchmarking. Ninja+MSVC needs INCLUDE/LIB from vcvars64.bat, which CMake does not set up itself - so this preset only works from a developer shell. Ninja ships inside VS at Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },

    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "linux-base",
      "displayName": "Linux (GCC, Debug)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "inherits": "linux-base",
      "displayName": "Linux (GCC, Release)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-debug",
      "inherits": "linux-base",
      "displayName": "Linux (Clang, Debug)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-release",
      "inherits": "linux-base",
      "displayName": "Linux (Clang, Release)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-asan",
      "inherits": "linux-base",
      "displayName": "Linux Clang AddressSanitizer",
      "description": "Mirrors the MSVC asan preset. RelWithDebInfo for a usable stack trace without Debug's own overhead compounding ASan's.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "linux-clang-tsan",
      "inherits": "linux-base",
      "displayName": "Linux Clang ThreadSanitizer",
      "description": "The first real race detector this project has ever had access to. Every prior session substituted the determinism hash plus repeated ASan runs for this, explicitly documented in docs/RESULTS.md as weaker evidence than a real race detector - MSVC has no ThreadSanitizer at all. RelWithDebInfo like the ASan preset; TSan and ASan cannot run in the same binary, hence the separate preset rather than a combined one.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],

  "buildPresets": [
    { "name": "dev-debug",   "configurePreset": "dev",   "configuration": "Debug" },
    { "name": "dev-release", "configurePreset": "dev",   "configuration": "Release" },
    { "name": "dev-relwithdebinfo", "configurePreset": "dev", "configuration": "RelWithDebInfo" },
    { "name": "asan",        "configurePreset": "asan",  "configuration": "RelWithDebInfo" },
    { "name": "ninja",       "configurePreset": "ninja" },
    { "name": "linux-gcc-debug",     "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release",   "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-debug",   "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-asan",    "configurePreset": "linux-clang-asan" },
    { "name": "linux-clang-tsan",    "configurePreset": "linux-clang-tsan" }
  ],

  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-asan",
      "configurePreset": "linux-clang-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-tsan",
      "configurePreset": "linux-clang-tsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
